# OpenRouter API key used for LLM and image model calls.
OPENROUTER_API_KEY=sk-or-...

# Base URL for the OpenRouter API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional proxy used only for OpenRouter API requests.
# Empty means direct connection; process HTTP_PROXY / HTTPS_PROXY are ignored.
# Example: HTTP_PROXY=http://127.0.0.1:7890
HTTP_PROXY=

# Secret key used to sign and verify JWT access tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=must-be-set-in-env

# Secret for refresh tokens. If empty, falls back to JWT_SECRET.
# Use a separate value in production so access and refresh can be rotated independently.
JWT_REFRESH_SECRET=

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime (seconds). Short-lived so revocation is frequent.
JWT_ACCESS_EXPIRES_SECONDS=900

# Refresh token lifetime (seconds). 7 days by default.
JWT_REFRESH_EXPIRES_SECONDS=604800

# Docker Compose PostgreSQL credentials. Replace the password before deployment.
POSTGRES_USER=mediaforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediaforge

# Async PostgreSQL connection string for local, non-Docker development.
DATABASE_URL=postgresql+asyncpg://mediaforge:change-me@localhost/mediaforge
APP_ENV=development

# Redis connection string used for caching and task broker backends.
REDIS_URL=redis://localhost:6379/0

# MinIO is the only asset/upload storage backend.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET=mediaforge
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Browser-facing authenticated file route. Keep this relative path unless a
# reverse proxy exposes the API under a different prefix.
MINIO_PUBLIC_BASE_URL=/api/v1/files
# MinIO is normally on the local network; bypass system HTTP(S) proxies.
MINIO_BYPASS_PROXY=true

# Upload limits.
MAX_UPLOAD_SIZE=52428800

# Max concurrent Gemini Pro image generation jobs (global across tenants).
SEMAPHORE_GEMINI_PRO_IMAGE=10

# Max concurrent GPT image generation jobs (global across tenants).
SEMAPHORE_GPT_IMAGE=15

# Max concurrent Veo video generation jobs (global across tenants).
SEMAPHORE_VEO=5

# Max concurrent Seedance video generation jobs (global across tenants).
SEMAPHORE_SEEDANCE=8

# Site metadata sent in OpenRouter HTTP headers.
SITE_URL=https://mediaforge.local
SITE_TITLE=MediaForge

# LangChain model used by the supervisor agent.
AGENT_MODEL=openai/gpt-4o-mini
AGENT_FALLBACK_MODEL=openai/gpt-4o-mini
QUALITY_MODEL=openai/gpt-4o-mini
AGENT_CONFIRMATION_TTL_SECONDS=900
AGENT_GRAPH_CACHE_SIZE=256
AGENT_RECURSION_LIMIT=12
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_TEMPERATURE=0
AGENT_RAG_MIN_SCORE=0.25
AGENT_PROMPT_VERSION=2026-08-07.8
AGENT_SUMMARY_TRIGGER_MESSAGES=30
AGENT_SUMMARY_KEEP_MESSAGES=12

# Image generation model API names.
IMAGE_MODEL_PRO=google/gemini-3.1-flash-image
IMAGE_MODEL_FAST=openai/gpt-image-2
IMAGE_MODEL_BASE=qwen/qwen-image-3-pro

# Video generation model API names.
VIDEO_MODEL_VEO=google/veo-3.1
VIDEO_MODEL_SEEDANCE=bytedance/seedance-2.0

# LangSmith observability (optional).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mediaforge
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Assistant concurrency per tenant
AGENT_CONCURRENCY_PER_TENANT=2

# Milvus / Zilliz Cloud is the only vector store.
# For Zilliz Cloud: MILVUS_URI looks like https://xxx-xxxx.serverless.gcp-us-west1.cloud.zilliz.com
# MILVUS_TOKEN is the API key from Zilliz Cloud console.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=mediaforge

# DashScope (Alibaba Bailian) embedding models for RAG.
DASHSCOPE_API_KEY=
DASHSCOPE_TEXT_MODEL=text-embedding-v4
DASHSCOPE_TEXT_DIM=1024
DASHSCOPE_IMAGE_MODEL=qwen3-vl-embedding
DASHSCOPE_IMAGE_DIM=2560
DASHSCOPE_RERANK_MODEL=qwen3-vl-rerank
BESTSELLER_MIN_SALES_COUNT=1500
BESTSELLER_CANDIDATE_COUNT=12
BESTSELLER_STYLE_REFERENCE_COUNT=3

# Auth cookie settings.
COOKIE_ACCESS_NAME=mf_access
COOKIE_REFRESH_NAME=mf_refresh
COOKIE_CSRF_NAME=mf_csrf
# Set to True in production when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# CSRF header the frontend echoes back.
CSRF_HEADER_NAME=X-CSRF-Token

# Password policy.
PASSWORD_MIN_LENGTH=8
PASSWORD_BCRYPT_ROUNDS=12

# Login lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Public signup is disabled by default. Enable only for a controlled local demo,
# then disable it after creating the required account.
ALLOW_SELF_SIGNUP=false

# CORS: comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Logging (Loguru).
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=
LOG_ROTATION=50 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
